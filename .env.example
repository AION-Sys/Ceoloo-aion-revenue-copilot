# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo / preview rep sign-in (auto-on when Supabase public env is missing)
# ENABLE_DEMO_AUTH=true
# ENABLE_DEMO_AUTH=false
# SEED_REP_EMAIL=rep@demo.local
# SEED_REP_PASSWORD=demo-rep-password

# AION AI Gateway
AION_AI_GATEWAY_URL=
AION_AI_GATEWAY_API_KEY=

# AION event/learning infrastructure
AION_EVENTS_INGEST_URL=
AION_EVENTS_API_KEY=

# PostHog — analytics / experimentation plane (aion-docs ADR-010).
# Leave NEXT_PUBLIC_POSTHOG_KEY EMPTY to disable PostHog entirely (safe default:
# no requests, provider no-ops). PII-safe config lives in lib/analytics/posthog.ts:
# autocapture off, sanitized manual pageviews, session replay off by default.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Session replay is OFF unless set to 'true'; when on it masks all inputs + text.
NEXT_PUBLIC_POSTHOG_SESSION_RECORDING=false
